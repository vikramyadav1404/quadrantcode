{
  "name": "quadrantcode",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "build": "next build",
    "deploy:check": "tsx scripts/check-deployment-env.ts",
    "contrast": "tsx scripts/contrast.ts",
    "db:explain": "tsx scripts/explain-report.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx server/db/migrate.ts",
    "db:rollback": "tsx server/db/rollback.ts",
    "db:seed": "tsx scripts/seed.ts",
    "db:studio": "drizzle-kit studio",
    "dev": "next dev",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "prepare": "husky",
    "start": "next start",
    "test": "vitest run",
    "test:db:start": "tsx scripts/test-db.ts start",
    "test:db:stop": "tsx scripts/test-db.ts stop",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "worker": "tsx worker/index.ts",
    "db:backfill:urls": "tsx scripts/backfill-normalised-urls.ts",
    "avatars:cleanup": "tsx scripts/cleanup-avatars.ts",
    "sessions:sweep": "tsx scripts/sweep-sessions.ts",
    "executions:sweep": "tsx scripts/sweep-executions.ts",
    "execution:image:verify": "tsx scripts/verify-execution-image.ts",
    "snapshots:purge": "tsx scripts/purge-snapshots.ts",
    "snapshots:measure": "tsx scripts/measure-snapshot-storage.ts",
    "mistakes:rollup": "tsx scripts/rollup-mistakes.ts",
    "slo:measure": "tsx scripts/measure-slo.ts",
    "loadtest": "tsx scripts/load-test.ts",
    "demo:seed": "tsx scripts/demo-seed.ts",
    "demo:walk": "tsx scripts/demo-walkthrough.ts",
    "analytics:rollup": "tsx scripts/rollup-analytics.ts",
    "library:verify": "tsx scripts/verify-library-urls.ts",
    "native:validate": "tsx scripts/validate-native-problems.ts",
    "native:validate-references": "tsx scripts/validate-native-references.ts",
    "native:import": "tsx scripts/import-native-problems.ts",
    "native:generate": "tsx scripts/generate-native-problem-library.ts",
    "papers:generate": "tsx scripts/generate-assessment-papers.ts",
    "papers:validate": "tsx scripts/validate-assessment-papers.ts",
    "assessments:sweep": "tsx scripts/sweep-assessments.ts",
    "companies:seed": "tsx scripts/seed-companies.ts",
    "drill": "tsx scripts/restore-drill.ts",
    "schema:check": "tsx scripts/schema-drift.ts"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --max-warnings=0",
      "prettier --write"
    ],
    "*.{json,md,css,yml,yaml}": [
      "prettier --write"
    ]
  },
  "dependencies": {
    "@auth/drizzle-adapter": "^1.11.3",
    "@aws-sdk/client-s3": "^3.1110.0",
    "@aws-sdk/s3-request-presigner": "^3.1110.0",
    "@monaco-editor/react": "^4.7.0",
    "@sentry/nextjs": "^10.72.0",
    "@vercel/queue": "0.5.0",
    "@vercel/sandbox": "3.2.1",
    "clsx": "^2.1.1",
    "csv-parse": "^7.0.2",
    "csv-stringify": "^6.8.3",
    "drizzle-orm": "^0.45.2",
    "monaco-editor": "^0.56.0",
    "next": "^15.5.0",
    "next-auth": "^5.0.0-beta.32",
    "postgres": "^3.4.5",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "resend": "^6.19.0",
    "server-only": "^0.0.1",
    "tailwind-merge": "^3.3.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.6",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4.1.0",
    "@types/node": "^22.15.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vercel/sandbox-mock": "3.2.1",
    "dotenv": "^17.0.0",
    "drizzle-kit": "^0.31.1",
    "embedded-postgres": "^18.4.0-beta.17",
    "eslint": "^9.28.0",
    "eslint-config-next": "^15.5.0",
    "eslint-config-prettier": "^10.1.5",
    "husky": "^9.1.7",
    "lint-staged": "^16.1.0",
    "prettier": "^3.5.3",
    "tailwindcss": "^4.1.0",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.33.0",
    "vitest": "^3.2.0"
  },
  "overrides": {
    "dompurify": "3.4.14",
    "postcss": "8.5.26"
  }
}
