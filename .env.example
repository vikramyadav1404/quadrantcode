# ─────────────────────────────────────────────────────────────────────────────
# TraceLoop environment
# Copy to `.env.local` for the Next.js app and `.env` for the standalone worker.
# Every variable below has a one-line comment (F0.1 acceptance criterion).
# ─────────────────────────────────────────────────────────────────────────────

# ── Required at boot (app and worker both refuse to start without these) ──────

# Runtime mode; one of development | test | production.
NODE_ENV=development
# Postgres connection string. Supabase: use the pooled (pgbouncer) URL here.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/traceloop
# Absolute public origin, used for magic links, OG images and webhook callbacks.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── Phase 0.2 · database ─────────────────────────────────────────────────────

# Direct (non-pooled) Postgres URL; migrations need a session-mode connection.
DATABASE_URL_UNPOOLED=postgresql://postgres:postgres@localhost:5432/traceloop
# Separate database used by the integration test suite; wiped between runs.
TEST_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/traceloop_test

# ── Phase 0.3 · auth, email and phone OTP ────────────────────────────────────

# Auth.js signing secret; generate with `openssl rand -base64 32`.
AUTH_SECRET=
# Resend API key used to deliver magic-link and notification email.
RESEND_API_KEY=
# From address for outbound email, e.g. TraceLoop <no-reply@example.com>.
EMAIL_FROM=
# MSG91 auth key for phone OTP delivery; unset uses the console OTP provider.
MSG91_AUTH_KEY=
# MSG91 OTP template id registered against the sender.
MSG91_TEMPLATE_ID=

# ── Phase 0.5 · avatar storage (S3-compatible: Cloudflare R2) ────────────────
# NOT Supabase Storage: its signed UPLOAD urls take no expiry parameter, so the
# 60-second presign window cannot be enforced there. See docs/decisions.md D11.

# S3 endpoint, e.g. https://<account-id>.r2.cloudflarestorage.com
S3_ENDPOINT=
# Access key id for the bucket. Server-side only.
S3_ACCESS_KEY_ID=
# Secret access key paired with the id above.
S3_SECRET_ACCESS_KEY=
# Dedicated public-read bucket holding nothing but avatars.
S3_BUCKET=avatars
# Public origin serving the bucket (R2 custom domain or r2.dev subdomain).
S3_PUBLIC_BASE_URL=
# Set to 1 to run the live-bucket integration test; needs the four vars above.
STORAGE_INTEGRATION=0

# ── Phase 2.3 · queue runtime (BullMQ + Upstash Redis) ───────────────────────

# Redis connection string used by BullMQ in the worker process.
REDIS_URL=
# Upstash REST endpoint used for rate limiting from serverless routes.
UPSTASH_REDIS_REST_URL=
# Upstash REST token paired with the URL above.
UPSTASH_REDIS_REST_TOKEN=

# ── Phase 3 · execution and AI ───────────────────────────────────────────────

# Judge0 base URL (self-hosted or RapidAPI endpoint).
#
# Leave it empty and F3.1 runs against a fake that EXECUTES NOTHING — the editor
# works, the limits and the state machine are real, the results are not. Set it
# and `Judge0Provider` takes over; that code has never run against an instance,
# so verify the language ids against `GET /languages` before trusting a result.
#
# The limits in `EXECUTION_LIMITS` are SENT with every submission. Whether they
# are honoured — including the disabled network — depends on how the instance
# was deployed. This is not a sandbox this project built (D24).
JUDGE0_URL=
# Judge0 API key; empty for an unauthenticated self-hosted instance.
JUDGE0_API_KEY=
# Anthropic API key for the F3.4 AI gateway; unset disables AI features.
ANTHROPIC_API_KEY=

# ── Phase 4 · billing, messaging and observability ───────────────────────────

# Razorpay public key id used by the checkout widget.
RAZORPAY_KEY_ID=
# Razorpay secret key used for server-side API calls.
RAZORPAY_KEY_SECRET=
# Razorpay webhook signing secret; every webhook is verified against it.
RAZORPAY_WEBHOOK_SECRET=
# Telegram bot token used for reminder delivery and /start account binding.
TELEGRAM_BOT_TOKEN=
# Sentry DSN for the app and worker; unset disables error reporting.
SENTRY_DSN=

# ── Feature flags · all default to false until acceptance criteria pass ───────

# F0.3 · phone OTP sign-up and verification level 1.
FEATURE_PHONE_OTP=false
# F1.3 · streak tracking, daily goals and the contribution heatmap.
FEATURE_STREAK_ENGINE=false
# F2.2 · the four revision modes (blind, mistake-first, pattern, speed).
FEATURE_REVISION_MODES=false
# F2.4 · multi-channel reminders (in-app, email, Telegram).
FEATURE_NOTIFICATIONS=false
# F2.5 · contest sync and the upsolve queue.
FEATURE_CONTESTS=false
# F3.1 · Monaco editor and queued Judge0 execution.
FEATURE_EXECUTION=false
# F3.2 · session event log and diff-based code snapshots.
FEATURE_TIMELINE=false
# F3.3 · heuristic stuck-point inference (no AI).
FEATURE_STUCK_INFERENCE=false
# F3.4 · AI gateway for reflection summaries, classification and hints.
FEATURE_AI=false
# F3.5 · cross-session mistake memory and the weekly focus plan.
FEATURE_MISTAKE_MEMORY=false
# F4.1 · original problem authoring CMS and its quality gate.
FEATURE_ORIGINAL_PROBLEMS=false
# F4.2 · structured preparation tracks.
FEATURE_TRACKS=false
# F4.3 · coin ledger, trust score and anti-abuse.
FEATURE_COINS=false
# F4.4 · Razorpay subscriptions and entitlements.
FEATURE_BILLING=false
# F4.5 · timed mock assessment engine.
FEATURE_MOCKS=false
