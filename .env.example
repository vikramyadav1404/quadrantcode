# ─────────────────────────────────────────────────────────────────────────────
# Quadrantcode environment
# Copy to `.env.local` for the Next.js app and `.env` for the standalone worker.
# Every variable below has a one-line comment (F0.1 acceptance criterion).
# ─────────────────────────────────────────────────────────────────────────────

# ── Required at boot (app and worker both refuse to start without these) ──────

# Runtime mode; one of development | test | production.
NODE_ENV=development
# Postgres connection string. Supabase: use the pooled (pgbouncer) URL here.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/quadrantcode
# Absolute public origin, used for magic links, OG images and webhook callbacks.
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Public Sentry ingestion DSN used by the browser SDK (a DSN is not an auth token).
NEXT_PUBLIC_SENTRY_DSN=
# Public support mailbox displayed on contact and legal pages.
NEXT_PUBLIC_SUPPORT_EMAIL=

# ── Phase 0.2 · database ─────────────────────────────────────────────────────

# Direct (non-pooled) Postgres URL; migrations need a session-mode connection.
DIRECT_DATABASE_URL=
# Neon-compatible legacy name for the same direct URL; DIRECT_DATABASE_URL wins.
DATABASE_URL_UNPOOLED=postgresql://postgres:postgres@localhost:5432/quadrantcode
# Separate database used by the integration test suite; wiped between runs.
TEST_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/quadrantcode_test

# ── Phase 0.3 · auth, email and phone OTP ────────────────────────────────────

# Auth.js signing secret; generate with `openssl rand -base64 32`.
AUTH_SECRET=
# Optional Auth.js base URL; v5 normally infers the host unless a custom base path is used.
AUTH_URL=
# Set true only behind a trusted non-Vercel reverse proxy; Vercel is inferred automatically.
AUTH_TRUST_HOST=
# Set 1 only when a known non-Vercel proxy overwrites forwarded client-IP headers.
TRUST_PROXY=
# Resend API key used to deliver magic-link and notification email.
RESEND_API_KEY=
# From address for outbound email, e.g. Quadrantcode <no-reply@example.com>.
EMAIL_FROM=
# MSG91 auth key for phone OTP delivery; unset uses the console OTP provider.
MSG91_AUTH_KEY=
# MSG91 OTP template id registered against the sender.
MSG91_TEMPLATE_ID=

# ── Phase 0.3b · GitHub sign-in ──────────────────────────────────────────────
# BOTH or NEITHER. The provider is registered only when each is present, so a
# half-configured pair means GitHub is absent from /login and /settings/account
# rather than a button that fails after redirecting to a broken OAuth screen.
#
# Create at https://github.com/settings/developers → OAuth Apps. The callback
# URL is <NEXT_PUBLIC_APP_URL>/api/auth/callback/github and must match exactly.
#
# Accounts are linked on a GitHub-VERIFIED email matching an existing user
# (`allowDangerousEmailAccountLinking`). server/services/auth/config.ts records
# why that is sound here and when it would stop being.
# OAuth app client id.
GITHUB_ID=
# OAuth app client secret. Unset this and the provider disappears entirely.
GITHUB_SECRET=

# ── Test-server escape hatches · LEAVE BOTH UNSET ────────────────────────────
# `next start` sets NODE_ENV=production, so the browser suite runs production
# semantics without Redis or an SMS vendor. These two unlock the development
# fallbacks under that NODE_ENV, and exist only for a single-process test run.
#
# Setting either in a real deployment is a security decision, not a
# convenience: the first makes rate limits per-process (so, on serverless, no
# limit at all) and the second sends every OTP to stdout instead of a phone.
#
# Only the value "1" enables them. Both are absent from every deployment
# config and are set in playwright.config.ts alone.
# "1" permits the per-process rate limiter under NODE_ENV=production.
ALLOW_IN_MEMORY_RATE_LIMIT=
# "1" permits the console OTP provider under NODE_ENV=production.
ALLOW_CONSOLE_OTP=

# ── Phase 0.5 · avatar storage (S3-compatible: Cloudflare R2) ────────────────
# NOT Supabase Storage: its signed UPLOAD urls take no expiry parameter, so the
# 60-second presign window cannot be enforced there. See docs/decisions.md D11.

# S3 endpoint, e.g. https://<account-id>.r2.cloudflarestorage.com
S3_ENDPOINT=
# Access key id for the bucket. Server-side only.
S3_ACCESS_KEY_ID=
# Secret access key paired with the id above.
S3_SECRET_ACCESS_KEY=
# Dedicated public-read bucket holding nothing but avatars.
S3_BUCKET=avatars
# Public origin serving the bucket (R2 custom domain or r2.dev subdomain).
S3_PUBLIC_BASE_URL=
# Set to 1 to run the live-bucket integration test; needs the four vars above.
STORAGE_INTEGRATION=0

# ── Rate limiting (Upstash Redis) ────────────────────────────────────────────
#
# REDIS_URL was removed on 2026-09-16. It was a BullMQ connection string for a
# queue that F2.3 cut and that no code has ever opened; worker/index.ts says in
# its own header that no queues will attach. The README told people to set it.
#
# The Upstash REST pair below is unrelated and IS used — serverless rate
# limiting speaks REST, not the Redis wire protocol.

# Upstash REST endpoint used for rate limiting from serverless routes.
UPSTASH_REDIS_REST_URL=
# Upstash REST token paired with the URL above.
UPSTASH_REDIS_REST_TOKEN=

# ── Phase 3 · execution and AI ───────────────────────────────────────────────

# Explicit execution backend: vercel_sandbox, judge0, or fake (non-production only).
EXECUTION_BACKEND=
# Immutable Vercel Container Registry image reference ending in @sha256:<64 hex chars>.
EXECUTION_SANDBOX_IMAGE=
# Secret bearer value required by the daily execution reconciliation cron.
# At least 32 characters; surrounding whitespace is trimmed and a whitespace-only
# value counts as unset. Too short fails at boot rather than disabling the route
# silently. Generate with: npm exec auth secret
CRON_SECRET=
# Judge0 base URL (self-hosted Judge0 CE or another compatible endpoint).
#
# Used only when EXECUTION_BACKEND=judge0. It is never selected as an automatic
# fallback from Vercel Sandbox.
#
# The limits in `EXECUTION_LIMITS` are SENT with every submission. Whether they
# are honoured — including the disabled network — depends on how the instance
# was deployed. This is not a sandbox this project built (D24).
JUDGE0_URL=
# Judge0 API key; empty for an unauthenticated self-hosted instance.
JUDGE0_API_KEY=

# ── Phase 4 · observability ──────────────────────────────────────────────────
#
# ANTHROPIC_API_KEY, RAZORPAY_KEY_ID/KEY_SECRET/WEBHOOK_SECRET and
# TELEGRAM_BOT_TOKEN were removed on 2026-09-16. They belonged to cut tickets
# (F3.4 AI gateway, F4.4 billing, F2.4 notifications) and no code has ever read
# them. Each described a mechanism that does not exist — "used by the checkout
# widget", "every webhook is verified against it", "unset disables AI features"
# — so anyone provisioning from this file was being told to buy credentials for
# features that are not there. Re-add them with the ticket, not before.

# Sentry DSN for the app and worker; unset disables error reporting.
SENTRY_DSN=
# Sentry environment label, e.g. preview or production.
SENTRY_ENVIRONMENT=
# Sentry organization slug used only for source-map upload at build time.
SENTRY_ORG=
# Sentry project slug used only for source-map upload at build time.
SENTRY_PROJECT=
# Sentry build auth token; secret, server/build only, never NEXT_PUBLIC.
SENTRY_AUTH_TOKEN=

# ── Feature flags · all default to false until acceptance criteria pass ───────
#
# Ten flags were deleted on 2026-09-16 because they gated nothing: seven for cut
# tickets with no code (AI, BILLING, COINS, CONTESTS, NOTIFICATIONS,
# REVISION_MODES, TRACKS) and three for shipped, stable features that never read
# their flag (STREAK_ENGINE, STUCK_INFERENCE, MISTAKE_MEMORY). A flag listed
# here is a promise that setting it does something.

# F0.3 · phone OTP sign-up and verification level 1. ENFORCED.
FEATURE_PHONE_OTP=false
# F3.1 · Monaco editor and durable, explicitly selected execution backend. ENFORCED.
FEATURE_EXECUTION=false
# F4.5 · timed mock assessment engine. ENFORCED — false hides the start button
# on a paper page and refuses startAssessmentAction. Set true to take papers.
FEATURE_MOCKS=false
# F3.2 · session event log and diff-based code snapshots.
# NOT WIRED — capture runs regardless of this value. See docs/status.md.
FEATURE_TIMELINE=false
# F4.1 · original problem authoring CMS and its quality gate.
# NOT WIRED — native content is reachable regardless. See docs/status.md.
FEATURE_ORIGINAL_PROBLEMS=false
